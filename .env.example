# Copy to .env and fill in. Never commit .env.

# --- LLM gateway (packages/provider) ---
# Dev: OmniRoute local instance. Prod: self-hosted LiteLLM.
REFRACT_GATEWAY_URL=http://localhost:4000
# Key the gateway expects. For OmniRoute free tiers this can be a dummy value.
REFRACT_GATEWAY_KEY=
# Default model id, gateway-qualified, e.g. anthropic/claude-sonnet-5
REFRACT_MODEL=anthropic/claude-sonnet-5
# Hard daily spend cap (USD) — enforce before any LLM-calling code runs.
REFRACT_DAILY_SPEND_CAP_USD=5

# --- GitHub ---
# PAT with: pull_requests:read, contents:read, and PR comment write.
GITHUB_TOKEN=
# Shared secret for webhook HMAC verification (services/api).
GITHUB_WEBHOOK_SECRET=

# --- services/api ---
PORT=8080

# --- Kestra (docker-compose) ---
KESTRA_POSTGRES_PASSWORD=kestra

# --- Redis (Phase 5: rate limiting + review cache) ---
REDIS_URL=redis://localhost:6379
